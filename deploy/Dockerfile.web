# RentMate 前端 build + Nginx 反向代理（唯一對外的容器）
# 第一階段：build Vue 前端
FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# .env 已被 .dockerignore 排除，build 只會讀 .env.production（VITE_API_BASE_URL=/api）
# 機密（GEMINI_API_KEY 等）不會進入前端 bundle
RUN npm run build

# 第二階段：Nginx 服務靜態檔 + 反向代理 API
FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
