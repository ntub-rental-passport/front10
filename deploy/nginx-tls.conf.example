# RentMate Nginx TLS 正式設定範本
# 使用方式（網域到手、certbot 首次簽發成功後）：
#   1. 全檔把 rentmate.software 換成你的網域
#   2. 覆蓋 deploy/nginx.conf 的內容（保留這份的結構）
#   3. compose 設定 COOKIE_SECURE=true，docker compose up -d --build
#   4. SSL Labs 掃描驗證，目標 A+
# 首次簽發指令見 deploy/README.md 的 TLS 章節。

# ===== Cloudflare 真實 IP 還原 =====
# 開啟 Cloudflare 橘雲代理後，流量都從 Cloudflare 轉發過來，Nginx 看到的
# $remote_addr 會全變成 Cloudflare 的 IP —— 若不還原，全世界使用者會共用
# 同一份限流配額（正常人被誤擋），fail2ban 也會去封鎖 Cloudflare（等於自斷連線）。
# 下列設定讓 Nginx 從 CF-Connecting-IP 標頭取回真實使用者 IP。
# 沒啟用 Cloudflare 時這些指令不會生效，可安全預先放著。
#
# ⚠️ IP 段會異動，啟用 Cloudflare 前先核對官方清單：
#     curl -s https://www.cloudflare.com/ips-v4 && curl -s https://www.cloudflare.com/ips-v6
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# ===== Rate Limiting（key 為還原後的真實使用者 IP）=====
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=ocr_limit:10m rate=5r/m;
# 靜態資源／SPA 路徑：依實際流量分析新增。
# 上線後的存取記錄顯示 89% 請求為外部掃描探測，且集中在靜態路徑（單一來源達 1890 次），
# 原先僅 /api/ 有節流，此處完全不設防。額度取較寬鬆值以免影響正常頁面載入
# （一次頁面載入約數十個請求），但足以壓制高速掃描。
limit_req_zone $binary_remote_addr zone=static_limit:10m rate=30r/s;
limit_req_status 429;

# HTTP：只留 ACME 驗證，其餘 301 到 HTTPS
server {
    listen 80;
    server_name rentmate.software www.rentmate.software;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name rentmate.software www.rentmate.software;

    # ===== TLS（目標 SSL Labs A+）=====
    ssl_certificate     /etc/letsencrypt/live/rentmate.software/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rentmate.software/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;                 # 停用 TLS 1.0/1.1
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 80m;

    # 正式 CORS 僅允許本站；desktop/ 已無用戶端程式，開發前端也走 /api 代理。
    # 不需要 OPTIONS preflight；擋掉其他方法，避免 TRACE/TRACK 等洩漏代理資訊。
    # 自訂 405 內容，避免預設錯誤頁帶出伺服器名稱；if 內只使用合法的 return。
    if ($request_method !~ "^(GET|HEAD|POST|PUT|PATCH|DELETE)$") {
        return 405 "Method Not Allowed\n";
    }

    # 註：以下兩段來自不同分支，彼此無關，合併時兩段都保留 ——
    # 上段是請求層的方法閘門（ZAP 強化），下段是回應層的壓縮設定。

    # ===== 回應壓縮（gzip）=====
    # nginx 官方鏡像的 nginx.conf 雖然已經有 gzip on，但 gzip_types 預設「只有」text/html，
    # 所以 JS／CSS／JSON 一直是以未壓縮原樣傳輸 —— 這個檔案先前完全沒提過 gzip，等於默認了這件事。
    # 2026-10-13 實測未壓縮傳輸量：entry bundle 348 KB、CSS 172 KB，
    # 而 public/data/new-taipei-garbage.json 高達 17.4 MB（由 /data/ 路徑提供給前端下載）。
    # 這些都是純文字，壓縮比極高；校園／行動網路的「開站很久才有畫面」大半花在這上面。
    #
    # ⚠️ 為什麼這組指令放在 server 層，而不是跟 limit_req_zone 一起放檔案最上層（http 層）：
    # 本檔是以 conf.d 片段的形式被 include 進官方鏡像「既有的」http 區塊
    #（deploy/Dockerfile.web：COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf）。
    # 那個 http 區塊本身可能已經有一行 gzip on —— Ubuntu 套件版的 /etc/nginx/nginx.conf
    # 第 46 行就是未註解的 gzip on，而 nginx 原始碼附的那份是註解掉的，兩種都存在。
    # 一旦撞上有 gzip on 的那種，同一個 context 出現兩次同名指令，nginx 會直接拒絕啟動：
    #   [emerg] "gzip" directive is duplicate in .../conf.d/default.conf:1
    # 2026-10-13 以本機 nginx 1.24 實測重現過這個 emerg（外層 http 放 gzip on + 本檔最上層也放）。
    #
    # 放在 server 層就兩種鏡像都能啟動：gzip 及其相關指令在 http／server／location 三種
    # context 都合法，server 層與 http 層是不同 context 不會重複，且 server 層會覆寫 http 層。
    # 所以不需要先確認鏡像裡到底是哪一種 —— 這比去賭鏡像內容可靠。
    #
    # 只放在 443 這個 server：listen 80 那個 server 只做 ACME 驗證與 301 轉址，
    # 回應都是幾十 bytes 的轉址標頭，壓縮毫無意義。
    gzip on;
    # ⚠️ 這行不能漏：gzip_proxied 預設是 off，只要請求帶 Via 標頭（即來自代理）nginx 就跳過壓縮。
    # 本站在 Cloudflare 橘雲後面，正式站的每一個請求都是代理轉發來的 ——
    # 少了這行，上面的 gzip 設定在正式站等於沒生效，只有直連 VM IP 測試時才看得到壓縮，
    # 於是會得出「設定沒問題」的錯誤結論。
    gzip_proxied any;
    # gzip_vary：讓 Cloudflare 與瀏覽器快取以 Accept-Encoding 區分壓縮／未壓縮兩個版本。
    # 本站有 CDN 在前面，少了這行會出現「壓縮版被餵給不支援的客戶端」或
    # 「快取到未壓縮版讓全體使用者白做工」—— 兩種都是只在 CDN 後面才會踩到的坑。
    gzip_vary on;
    # 刻意只列純文字型態。png/jpg/webp/woff2/zip 本身已經是壓縮格式，
    # 再壓一次換不到幾個位元組卻要白燒 CPU，所以不放進來。
    gzip_types application/javascript text/javascript application/json application/manifest+json text/css image/svg+xml text/plain text/xml;
    # 小於 1 KB 的回應壓縮後往往反而變大（gzip 有固定標頭成本），多花的 CPU 也換不回頻寬。
    gzip_min_length 1024;
    # 等級取 5：對 JS／JSON 這類文字，5 已經拿到接近等級 9 的壓縮率，CPU 成本卻大約只有一半。
    # VM 規格有限，壓那支 17 MB 的 JSON 時這個差距很有感，所以不往上加。
    gzip_comp_level 5;

    # ===== 安全標頭 =====
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # 點交存證需要本站相機；跨站 iframe 仍不可使用。麥克風維持關閉。
    add_header Permissions-Policy "camera=(self), microphone=(), payment=()" always;
    # HSTS：2026-08-19 由觀察值 600 調整為正式值 31536000（1 年）。
    # 調長前提已滿足：全站 HTTPS 運作正常、certbot 自動續期排程已設定。
    # 意義：瀏覽器在期限內「只」以 HTTPS 連本站，連使用者手動輸入 http:// 也會自動改寫，
    # 可阻斷 SSL stripping（中間人把連線降級為明文）攻擊。
    # 注意：一旦瀏覽器記住，期限內無法以 HTTP 存取本網域，故需確保憑證續期不中斷。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # 隔離瀏覽環境，防止跨來源視窗操作本頁；Google 登入是整頁轉址，不需要彈窗相容。
    # 通知鈴鐺的 window.open 已設 noopener,noreferrer；補助文件開 about:blank 後寫入，
    # 仍是 same-origin，兩者在此政策下都能正常使用。
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # 只限制別站嵌入本站資源，不影響本站自己載入外部圖片。
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # 不用 require-corp：外部圖片沒有 CORP 標頭會被擋。
    # credentialless 讓跨來源 no-cors 請求不帶 cookie 載入；本站外部圖片都是公開資源，故不受影響。
    # 不支援的瀏覽器（如 Safari）會忽略此標頭，不會壞掉。
    add_header Cross-Origin-Embedder-Policy "credentialless" always;
    # CSP 正式模式（2026-08-19 由觀察模式轉正式）
    # 已驗證：前端所有外部資源皆為圖片（Google 圖示、QR code）或頁面跳轉，
    # 無任何外部 script/stylesheet，故 script-src 'self' 不會誤擋。
    # 地圖功能需要 connect-src 放行 openfreemap（向量圖磚）與 nominatim（地理編碼），
    # maplibre 使用 blob worker 故需 worker-src blob:。
    # form-action / base-uri / frame-ancestors 這三個指令「不會」繼承 default-src，
    # 未明確宣告等於完全無防護（ZAP 規則 10055 即檢查此點）：
    #   form-action 'self'  → 表單只能提交回本站，防止竄改後的表單把資料送到攻擊者伺服器
    #   base-uri 'self'     → 防止注入 <base href="evil.com"> 竄改全站相對路徑的解析目標
    #   frame-ancestors 'none' → 禁止被任何網站 iframe（點擊劫持防護）
    # 2026-10 用僅回報模式觀察訪客、管理員、租客、房東四種身分；唯一違規來自 reka-ui
    # SelectViewport 寫死的隱藏捲軸 CSS。地圖、動畫、圖表與 Vue :style 均無違規（證據：Doc/資安重測-2026-10/08-正式站驗證/）。
    # 因此只放行該段 CSS 的 SHA-256；src/utils/csp-style-hash.test.ts
    # 會在升級 reka-ui 時檢查 hash。新增會插入 <style> 的元件（如 ScrollArea、Combobox）前，須先計算 hash 並加入 CSP。
    #
    # img-src 已由 https:（萬用）收斂為實際使用的來源清單（ZAP 規則 10055 Wildcard Directive）：
    #   gstatic / jsdelivr      → 登入註冊頁的 Google 圖示 SVG
    #   qrserver                → 邀請連結的 QR code 產生服務
    #   placehold.co / picsum   → 房源示意圖佔位服務
    #   tiles.openfreemap.org   → 地圖圖磚與 sprite
    #   *.googleusercontent.com → Google 登入使用者的頭像
    # 新增外部圖片來源時必須同步更新此清單，否則圖片會被瀏覽器擋下。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-60LHlRjW/B3CtzIoE/Lf1/NEDvko9efWMFaGVhHu/cs='; img-src 'self' data: blob: https://www.gstatic.com https://cdn.jsdelivr.net https://api.qrserver.com https://placehold.co https://picsum.photos https://tiles.openfreemap.org https://*.googleusercontent.com; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://tiles.openfreemap.org https://nominatim.openstreetmap.org; form-action 'self'; base-uri 'self'; frame-ancestors 'none'" always;

    # ===== 路由 + 分段限流（與 HTTP 版相同）=====

    # 這兩個唯讀／無密碼的 auth 端點刻意從 login_limit 拆出來，改走寬鬆的 api_limit。
    #
    # 2026-10-13 診斷「學校網路登入要等很久」的根因就在這裡：下面的 location /api/auth/
    # 是 prefix match，會一併蓋住 /api/auth/me —— 而 /me 是前端每次進站都會打的
    # 登入狀態查詢（src/services/authApi.ts 的 fetchCurrentUser），不是使用者按下登入才發生的。
    # 再加上 real_ip_header CF-Connecting-IP 取回的是使用者的公開 IP，校園網路全校走同一組
    # NAT 出口，$binary_remote_addr 對校內所有人是同一個值 → 全校共用同一份配額。
    # 一堂課 30 個學生同時開網站，光是 /me 就把 login_limit 的 2r/s 吃乾，
    # 真正的登入請求反而撞牆拿到 429，使用者看到的就是「卡住」。
    #
    # 為什麼拆得掉而不算放寬防線：這兩個端點都不驗密碼 —— /me 只是拿 cookie 查自己是誰，
    # /logout 只是清 session，都不是密碼暴力破解的標的，留在嚴格額度裡換不到安全性。
    #
    # 為什麼用 location =：精確比對在 nginx 的優先權最高，早於 ^~ 也早於 prefix match，
    # 所以這兩條會穩定贏過 location /api/auth/ 與 location ^~ /api/，
    # 且因為是精確比對，其他 /api/auth/* 端點（login、register…）完全不受影響。
    location = /api/auth/me {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://fastapi:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth/logout {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://fastapi:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/auth/ {
        # burst=30 delay=10（原為 burst=5 nodelay），但 rate=2r/s 維持不動。
        #
        # 為什麼 rate 絕對不能調大：2026-10-13 查過 backend/routers/auth.py:345-388 的 /login，
        # 後端完全沒有帳號層的登入失敗鎖定（auth.py 裡的 attempts_remaining 全是給
        # 註冊驗證碼與管理員 2FA 用的，schema 裡也沒有 failed_login_count／locked_until 欄位）。
        # 前端 src/utils/login-lockout.ts 的鎖定只存在 localStorage，攻擊者用 curl 直接繞過。
        # 也就是說，這條 nginx 限流是密碼暴力破解「唯一」的真實防線，一放寬就等於沒有防護。
        #
        # 所以改的是「超量時怎麼處理」而不是速率：前 10 個請求立刻放行（delay=10），
        # 第 11~30 個不回錯誤而是排隊、以 2r/s 慢慢放行，超過 30 才回 429。
        # 持續速率仍然是 2r/s，暴力破解者一點好處都拿不到；
        # 但一整班同時登入的尖峰變成「稍等幾秒」，而不是看到假的服務中斷錯誤。
        limit_req zone=login_limit burst=30 delay=10;
        proxy_pass http://fastapi:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ocr {
        limit_req zone=ocr_limit burst=2 nodelay;
        proxy_pass http://ocr:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # 容器之間專用的端點（OCR 服務回報 Vision 用量，見 backend/routers/ai_usage_api.py）：
    # OCR 容器直接連 fastapi:8000，不經過這裡，所以從外面進來的一律擋掉。
    # 端點本身也要服務憑證，這裡是多一層。
    location ^~ /api/internal/ {
        return 404;
    }

    # ^~：API 路徑不再比對下面的 regex location。少了它，結尾帶副檔名的 API
    #（/api/content/banner-images/xxx.webp、DELETE /api/admin/banner-images/xxx.webp）
    # 會被「帶副檔名就當靜態檔」那條規則攔走，直接回 nginx 404（2026-10-08 發現）。
    # 隱藏檔與敏感副檔名的封鎖規則因此不套用到 /api/，但 /api/ 一律轉給 FastAPI，不會讀到磁碟上的檔案。
    location ^~ /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://fastapi:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # ACME 憑證驗證：以 ^~ 修飾，避免被下方的隱藏檔封鎖規則（regex location）攔截
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 封鎖隱藏檔探測 —— 依實際攻擊記錄新增。
    # 存取記錄顯示 /.env（226 次）與 /.git/*（197 次）是最主要的探測目標，
    # 攻擊者意圖取得環境變數中的資料庫密碼、API 金鑰，或下載原始碼倉庫。
    # 原本這些請求會落入下方 SPA fallback 而回傳 200（雖未洩密，但等同確認路徑存在）。
    location ~ /\. {
        deny all;
        access_log off;
    }

    # 封鎖其他常見敏感檔案探測（wp-config、備份檔、設定檔等）
    location ~* \.(env|sql|bak|old|conf|ini|log|sh)$|wp-config|phpinfo {
        deny all;
        access_log off;
    }

    # 任何「帶副檔名」的請求：檔案不存在即回 404，不落入 SPA fallback。
    #
    # 為何用通用規則而非列舉副檔名：原先列舉 js/css/png 等，ZAP 便改猜 .txt / .jar
    #（如 /robots.jar、/Copy (2) of robots.txt），列舉永遠追不上猜測，形同打地鼠。
    # 根因是 SPA fallback 對任何不存在路徑都回 index.html(200)，掃描器據此判定「檔案存在」。
    #
    # 安全性：真正的 SPA 路由一律不帶副檔名（/login、/contract），故不受影響；
    # 實際存在的檔案（bundle、favicon、robots.txt、隱私權政策 PDF）由 try_files 正常提供。
    # 帶 hash 的 bundle：檔名一變內容就一定不同，可以放心讓瀏覽器長期快取。
    # 用 expires 而不是 add_header Cache-Control —— 見下方 location / 的說明。
    location ^~ /assets/ {
        limit_req zone=static_limit burst=60 nodelay;
        expires 1y;
        try_files $uri =404;
    }

    # /data/ 的開放資料（垃圾清運站點、台電停電）必須自己宣告快取，否則完全不會被快取。
    # 2026-10-14 實測：/data/new-taipei-garbage.json 的回應「沒有任何 Cache-Control 標頭」，
    # 回頭 cf-cache-status 永遠是 DYNAMIC；而同為靜態檔的 /theme-boot.js 卻是 HIT。
    # 差別在於下面那條通用規則沒有 expires，於是：
    #   .js/.css/.png → 命中 Cloudflare 的「預設可快取副檔名清單」，仍會被邊緣快取
    #   .json         → 不在那份清單裡，少了 Cache-Control 就兩邊都不快取
    # 後果是每一位訪客、每一次進垃圾清運頁，都要把整包資料從台北的 origin 重新拉一次；
    # 本站的 Cloudflare 邊緣節點在美國加州（colo=SJC，實測 RTT 136 ms，origin 本機只要 7 ms），
    # 所以這一包是跨太平洋來回一趟才到使用者手上。
    #
    # 取 1 小時而不是更久：垃圾清運資料每月由 GitHub Action 更新、台電停電資料更新更頻繁，
    # 這兩個檔名都沒有內容 hash（不像 /assets/ 的 bundle），所以不能比照 1y。
    # 1 小時足以讓同一位使用者在一次使用期間內不再重抓，又不會讓資料過期太久。
    #
    # 用 expires 而不是 add_header Cache-Control —— 見下方 location / 的說明
    #（add_header 一旦出現在 location 裡，server 層的 CSP／HSTS 等標頭會整組消失）。
    location ^~ /data/ {
        limit_req zone=static_limit burst=60 nodelay;
        expires 1h;
        try_files $uri =404;
    }

    location ~ "\.[A-Za-z0-9]{1,8}$" {
        limit_req zone=static_limit burst=60 nodelay;
        try_files $uri =404;
    }

    # SPA fallback：非 API、非靜態資源的路徑回 index.html，由 vue-router 處理
    # index.html 的快取規則要放在這裡（location = 精確比對，優先權最高）。
    #
    # 為什麼不能只寫在下面的 location /：SPA 路徑（/staff-login、/login）是靠
    # try_files 內部轉址到 /index.html，而 nginx 轉址後會「重新比對一次 location」，
    # /index.html 帶副檔名，於是落到上面那條 \.[A-Za-z0-9]{1,8}$ 規則，
    # location / 裡的 expires 根本套不到。2026-09-08 實測踩到這個坑。
    location = /index.html {
        limit_req zone=static_limit burst=60 nodelay;
        expires -1;
    }

    # SPA 進入點 index.html 一律不快取。
    #
    # 為什麼一定要有這行：Vite 每次 build 都會換 bundle 的 hash 檔名並刪掉舊檔。
    # index.html 若沒有快取指示，瀏覽器會自行「猜」一個快取時間，
    # 於是舊的 index.html 會去要已被刪掉的 /assets/index-<舊hash>.js → 404 → 整頁空白。
    # 2026-09-08 部署後即實際發生（開發機瀏覽器白畫面，強制重載才好）。
    #
    # no-cache 不是「不快取」，而是「每次都先問伺服器」：
    # 內容沒變時靠 ETag 回 304，只有幾百 bytes，成本可忽略。
    #
    # ⚠️ 用 expires 而不是 add_header Cache-Control：nginx 的 add_header 只在
    # 「本層沒有任何 add_header」時才會繼承上層設定 —— 在這裡加一行 add_header，
    # server 區塊的 CSP、HSTS、X-Frame-Options 全部會從這個 location 消失。
    # expires 屬於另一組指令，不會觸發這個繼承規則。
    location / {
        limit_req zone=static_limit burst=60 nodelay;
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
