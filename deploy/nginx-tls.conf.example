# RentMate Nginx TLS 正式設定範本
# 使用方式（網域到手、certbot 首次簽發成功後）：
#   1. 全檔把 rentmate.software 換成你的網域
#   2. 覆蓋 deploy/nginx.conf 的內容（保留這份的結構）
#   3. compose 設定 COOKIE_SECURE=true，docker compose up -d --build
#   4. SSL Labs 掃描驗證，目標 A+
# 首次簽發指令見 deploy/README.md 的 TLS 章節。

limit_req_zone $binary_remote_addr zone=login_limit:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=ocr_limit:10m rate=5r/m;
limit_req_status 429;

# HTTP：只留 ACME 驗證，其餘 301 到 HTTPS
server {
    listen 80;
    server_name rentmate.software;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name rentmate.software;

    # ===== TLS（目標 SSL Labs A+）=====
    ssl_certificate     /etc/letsencrypt/live/rentmate.software/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rentmate.software/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;                 # 停用 TLS 1.0/1.1
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 80m;

    # ===== 安全標頭 =====
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), payment=()" always;
    # HSTS：先用短 max-age（600）觀察幾天，確認全站 HTTPS 無誤後改 31536000
    add_header Strict-Transport-Security "max-age=600; includeSubDomains" always;
    # CSP：Report-Only 觀察期結束後，把標頭名稱改成 Content-Security-Policy 轉正式
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://tiles.openfreemap.org https://nominatim.openstreetmap.org; frame-ancestors 'none'" always;

    # ===== 路由 + 分段限流（與 HTTP 版相同）=====
    location /api/auth/ {
        limit_req zone=login_limit burst=5 nodelay;
        proxy_pass http://fastapi:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ocr {
        limit_req zone=ocr_limit burst=2 nodelay;
        proxy_pass http://ocr:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://fastapi:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
