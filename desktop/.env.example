# 桌機代理的設定。複製成 desktop\.env 後填入。
# ⚠️ .env 本身已被 .gitignore 擋住（.env* 規則）。
#    desktop/ 其餘檔案在本機有版控，但**不推上 GitHub** ——
#    它描述的是「怎麼連進我家的網路」，跟 deploy/ 同一類。

# 代理自己的鑰匙。VM 的 .env 要填同一把。
# 產生：python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 沒填的話代理會拒絕啟動
LLM_TUNNEL_API_KEY=""

# Ollama 的位址。原生安裝的預設值就是這個，通常不用改。
OLLAMA_URL="http://127.0.0.1:11434"

# embedding 模型。必須與 VM 的 LOCAL_EMBEDDING_MODEL 一致，
# 也必須是建 rag/rental_law_db 時用的那個。
# ⚠️ 改這個就要重建語料向量：
#    docker compose exec -T fastapi python build_vectors.py --provider local
LOCAL_EMBEDDING_MODEL="shibing624/text2vec-base-chinese"

# 代理監聽的埠。只聽 127.0.0.1，cloudflared 從本機連進來。
PROXY_PORT="8787"

# 長文字切窗的大小（字）。模型上限 512 token，超過會被安靜截斷，
# 所以切窗後平均，讓整份合約都參與檢索。
# EMBED_WINDOW_CHARS="450"

# 等 Ollama 回應的上限（秒）。VM 那邊自己也有逾時，這裡設寬一點即可。
# PROXY_GENERATE_TIMEOUT="600"
