# ============================================================
# RentMate 環境變數範本
# ============================================================
# 複製成專案根目錄的 .env 再填值。.env 不進版控，這個檔案會公開，不要填真的密鑰。
#
# 分成三區：
#   A. 全組必須完全相同  —— 一律向專題負責人拿「同一份」，不要自己產生。
#   B. 每台電腦自己設    —— 路徑、本機服務，各自不同是正常的。
#   C. 選用              —— 不設就用程式預設值或停用該功能。
#
# ⚠️ 2026-10-05 的教訓：大家連同一個資料庫，A 區卻各用各的。結果是：
#    - PII_ENCRYPTION_KEY 不同 → 別人寫進去的租客電話、身分證你解不開
#      （共用資料庫裡已經有兩筆沒有人解得開的資料）
#    - AUTH_TOKEN_SECRET / JWT_SECRET 不同 → 在 A 電腦登入拿到的憑證，B 電腦的後端不認
#    A 區任何一個值要換，先在群組講好、所有人同時換，而且 PII_ENCRYPTION_KEY 不能換
#    （換了舊資料就再也解不開）。


# ============================================================
# A. 全組必須完全相同
# ============================================================

# ---- 資料庫 ----
# 開發與正式都連學校的 MySQL（主機位址與帳密向專題負責人索取，這個 repo 是公開的）。
# 只在自己電腦上試東西時才改成 localhost，而且那時候不要拿共用資料庫的資料來用。
DATABASE_URL="mysql+pymysql://帳號:密碼@學校主機:3306/115-RentMate"

# 個資加密金鑰（租客電話、身分證、地址…）：Base64 編碼的 32 bytes。
# ⚠️ 絕對不要自己產生、不要更換、不要遺失。用錯金鑰寫入的資料，別人永遠解不開；
#    金鑰遺失，所有加密資料一起消失。另外找安全的地方備份一份。
# （只有「全新、空的資料庫」才產生新的：
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"）
PII_ENCRYPTION_KEY=""

# 登入憑證的簽章金鑰。不同的話，一台電腦簽的登入憑證另一台不認。
# AUTH_TOKEN_SECRET：房東／租客 API 的 Bearer token
# JWT_SECRET：cookie 版登入，FastAPI 與 OCR Express server 必須共用
AUTH_TOKEN_SECRET=""
JWT_SECRET=""

# Email 驗證碼
VERIFICATION_CODE_SECRET=""
VERIFICATION_CODE_EXPIRES_SECONDS="120"
VERIFICATION_CODE_MAX_ATTEMPTS="3"
VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
VERIFICATION_MAX_SENDS="5"

# 寄信（驗證碼、通知）：專題共用的 Gmail 與應用程式密碼
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_APP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="RentMate"

# Google 登入（OAuth）。GOOGLE_CLIENT_SECRET 只給後端，不可出現在 VITE_ 開頭的變數。
# 也可以改用 GOOGLE_CLIENT_SECRET_FILE 指向下載的 JSON（見 B 區），兩者擇一。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""   # 與 GOOGLE_CLIENT_ID 相同
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"

# 合約分析與法規問答的雲端模型（backend/ai/llm_provider.py）
# 正式環境僅用 NVIDIA，未設定或失敗時 API 回傳 503；Ollama 僅供本機開發選用。
NVIDIA_API_KEY=""


# ============================================================
# B. 每台電腦自己設（不同是正常的）
# ============================================================

# ---- 前後端位址（本機開發照抄即可）----
FRONTEND_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_OCR_API_URL="http://localhost:8787"
OCR_API_PORT="8787"
# 本機 http 開發保持 false；正式站 HTTPS 設 true
COOKIE_SECURE="false"

# ---- 金鑰檔案的位置（檔案本身向專題負責人拿，放在自己電腦上）----
# Google Cloud Vision（OCR）服務帳號 JSON。建議放專案的 key/ 資料夾（已排除版控），寫相對路徑。
GOOGLE_APPLICATION_CREDENTIALS="./key/vision-key.json"
# Google OAuth 的 client secret JSON（與 A 區的 GOOGLE_CLIENT_SECRET 擇一）
# GOOGLE_CLIENT_SECRET_FILE="./key/client_secret.json"

# ---- 本機 Ollama（沒裝就把 OLLAMA_OCR_ENABLED 設 false）----
# OCR 欄位複核（server/ollama-contract.js）。需先 ollama pull gemma4:e2b。
OLLAMA_OCR_ENABLED="false"
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_OCR_MODEL="gemma4:e2b"
# 8 GB 記憶體的電腦：小 context、首次載入給長一點的逾時
# OLLAMA_OCR_CONTEXT_LENGTH="2048"
# OLLAMA_OCR_TIMEOUT_MS="300000"
# OLLAMA_OCR_MAX_CHARS="2500"
# OLLAMA_OCR_NUM_PREDICT="220"

# 合約分析用的 Ollama 模型（必須是 ollama list 裡有的），與 OCR 模型分開設定
# OLLAMA_MODEL="gemma4:e2b"
# OLLAMA_THINK="false"            # 支援 thinking 的模型關掉額外思考，省 CPU
# OLLAMA_CHAT_MODEL=""            # Law Chat 專用，未設定沿用 OLLAMA_MODEL

# ---- 本機開發：管理員免驗證碼登入（backend/routers/auth.py）----
# 開發用的測試管理員信箱收不到信，設定後只有這個帳號登入時會直接帶入驗證碼。
# 有結構性守衛：DATABASE_URL 主機不是 localhost / 127.0.0.1 時不會生效。
# ⚠️ 正式環境不要設定。
# DEV_ADMIN_NO_2FA_EMAIL="admin@rentmate.tw"


# ============================================================
# C. 選用（不設就用預設值）
# ============================================================

# ---- OCR 上傳限制：一份 PDF 或最多 20 張圖，檔案只在辨識時暫存在記憶體 ----
# OCR_MAX_FILE_SIZE_MB="20"
# OCR_MAX_TOTAL_SIZE_MB="80"
# OCR_MAX_FILE_COUNT="20"
# OCR_VISION_CONCURRENCY="4"

# ---- 合約分析的模型來源 ----
# 依序嘗試，第一個成功就用；全部失敗回 503，絕不以預設內容填補
# （使用者會把那當成針對自己合約的真實分析）。
# LLM_PROVIDER_ORDER="nvidia,ollama"
# ⚠️ NVIDIA 會下架模型（meta/llama-3.1-70b-instruct 於 2026-09-29 消失，呼叫回 410）。
#    換模型前先跑：python backend/scripts/check_llm.py --models
#    2026-09-30 實測 nemotron-3-super-120b-a12b 分析 4/4、法源 7/7、對話 6.9 秒，最均衡。
# NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
# NVIDIA_CHAT_MODEL=""
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# reasoning 類模型才開；不認得這個參數的模型會回 400
# NVIDIA_DISABLE_THINKING="false"
# NVIDIA_CHAT_DISABLE_THINKING="false"

# 正式環境只使用 NVIDIA 生成；失敗時 API 回傳 503。Ollama 僅供本機開發選用。
# OLLAMA_URL / LOCAL_EMBEDDING_URL 由 docker-compose.yml 設定，不放在 .env。
# RAG embedding 備援使用 http://rag:8000，透過私有 Docker 網路連線。
# 正式環境沒有 Ollama，OCR 的 Ollama 欄位複核停用（OLLAMA_OCR_ENABLED=false）。

# ---- 法規檢索（backend/ai/embeddings.py）----
# 依序嘗試，全部失敗就退回「29 塊全部給」。
# ⚠️ 不同模型的向量不能混用，改了模型名稱就要重建向量：
#    python scripts/build_vectors.py --provider local
# EMBEDDING_PROVIDER="nvidia"
# 正式環境設為 "nvidia,local"，RAG 容器只在 NVIDIA 失敗時提供備援。
# EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"
# LOCAL_EMBEDDING_MODEL="shibing624/text2vec-base-chinese"
# 本機開發要使用 embedding 備援時才設定；不會沿用生成服務的 OLLAMA_URL。
# LOCAL_EMBEDDING_URL="http://127.0.0.1:8000"
# LAW_TOP_K="8"                   # 實測 8 最好，太少會漏、太多雜訊稀釋

# ---- 逾時與降級 ----
# 上游連不上之後，多久內直接跳過（秒）；0 停用
# UPSTREAM_COOLDOWN_SECONDS="60"
# OLLAMA_CONNECT_TIMEOUT="5"
# OLLAMA_ANALYZE_TIMEOUT="180"
# OLLAMA_CHAT_TIMEOUT="60"
# LLM_CONNECT_TIMEOUT="5"
# LLM_MAX_ATTEMPTS="2"

# ---- 其他功能 ----
# 臺北市垃圾車 GPS（見 docs/taipei-garbage.md）
# TAIPEI_GARBAGE_GPS_URL=""
# Web Push：成對的 VAPID 金鑰；私鑰可以是 PEM 檔路徑
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:your-service-contact@example.com"
# GOOGLE_OAUTH_TRUST_ENV_PROXY="false"
# LOG_LEVEL="INFO"


# ============================================================
# 正式部署（Docker Compose／學校 VM）專用
# ============================================================
# 正式網域
# CORS_ORIGINS="https://你的網域"
# COOKIE_SECURE="true"

# docker-compose.yml 用這個組出 fastapi 的 DATABASE_URL，不把密碼寫進 compose 檔。
# 要填網址編碼後的值：@ → %40、: → %3A、/ → %2F（不編碼的話密碼裡的 @ 會切斷連線字串）。
# SCHOOL_DB_PASSWORD=""
# MYSQL_ROOT_PASSWORD=""
# MYSQL_PASSWORD=""

# 上傳檔案的存放位置。資料庫只記伺服器產生的檔名，檔案本體在這些目錄。
# 沒設定時預設在 backend/uploads/ 底下（本機開發用）。
# ⚠️ 正式站必須是持久化的 volume 並納入備份：目錄被清掉，照片與附件就永久消失。
# INSPECTION_UPLOAD_DIR="/srv/rentmate/uploads/inspection"
# REPAIR_UPLOAD_DIR="/srv/rentmate/uploads/repairs"
# LEASE_FILE_DIR="/srv/rentmate/uploads/contracts"
# BANNER_IMAGE_DIR="/srv/rentmate/uploads/banners"
