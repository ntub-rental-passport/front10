# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OCR API: Local Express OCR server for contract scanning.
OCR_API_PORT="8787"
# Upload limits: one PDF or up to 20 images. Files are kept in memory only while OCR runs.
OCR_MAX_FILE_SIZE_MB="20"
OCR_MAX_TOTAL_SIZE_MB="80"
OCR_MAX_FILE_COUNT="20"
OCR_VISION_CONCURRENCY="4"

# Google Cloud Vision will read this service account JSON locally via ADC.
# Example on Windows:
# GOOGLE_APPLICATION_CREDENTIALS="C:\\keys\\rentmate-vision.json"
GOOGLE_APPLICATION_CREDENTIALS="C:\\path\\to\\service-account.json"

# Local AI OCR field review. Install Ollama and pull gemma4:e2b before enabling.
OLLAMA_OCR_ENABLED="true"
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_OCR_MODEL="gemma4:e2b"
# E2B on an 8 GB machine needs a conservative context and a generous first-load timeout.
OLLAMA_OCR_CONTEXT_LENGTH="2048"
OLLAMA_OCR_TIMEOUT_MS="300000"
OLLAMA_OCR_MAX_CHARS="2500"
OLLAMA_OCR_NUM_PREDICT="220"

# Optional: dev proxy target for Vite.
VITE_OCR_API_URL="http://localhost:8787"

# Google OAuth web-server flow. Never expose GOOGLE_CLIENT_SECRET to Vite/browser code.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_WEB_CLIENT_SECRET"
# Alternative to GOOGLE_CLIENT_SECRET: load Google's downloaded OAuth JSON directly.
GOOGLE_CLIENT_SECRET_FILE="C:\\path\\to\\client_secret.json"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
FRONTEND_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:8000/api"

# MySQL and email verification. Keep these values on the backend only.
DATABASE_URL="mysql+pymysql://username:password@localhost:3306/115-RentMate"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-account@gmail.com"
SMTP_APP_PASSWORD="YOUR_16_DIGIT_GOOGLE_APP_PASSWORD"
SMTP_FROM_EMAIL="your-account@gmail.com"
SMTP_FROM_NAME="RentMate"
VERIFICATION_CODE_SECRET="GENERATE_AT_LEAST_32_RANDOM_BYTES"
VERIFICATION_CODE_EXPIRES_SECONDS="120"
VERIFICATION_CODE_MAX_ATTEMPTS="3"
VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
VERIFICATION_MAX_SENDS="5"

# JWT 認證（FastAPI 與 OCR Express server 必須共用同一組 secret）
# 產生方式：openssl rand -hex 32
JWT_SECRET="CHANGE_ME_openssl_rand_hex_32"
# 正式環境（HTTPS）設 true，本機開發保持 false
COOKIE_SECURE="false"

# ===== 正式部署（Docker Compose / 學校 VM）專用 =====
# MySQL 容器初始化密碼（compose 會用 rentmate/MYSQL_PASSWORD 建立應用帳號）
MYSQL_ROOT_PASSWORD="CHANGE_ME_strong_root_password"
MYSQL_PASSWORD="CHANGE_ME_strong_app_password"
# VM 上若有裝 Ollama（跑在主機而非容器）維持預設即可；沒裝也能跑（LLM 功能自動 fallback）
# OLLAMA_URL="http://host.docker.internal:11434"
# 正式網域確定後填入，例如 https://rentmate.example.me
# CORS_ORIGINS="https://你的網域"
